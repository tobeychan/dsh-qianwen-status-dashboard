{
  "name": "dsh-qianwen-status-dashboard",
  "version": "1.2.2",
  "type": "module",
  "description": "Qianwen status dashboard for DeepSeek Harness: login state, Token expiry countdown, subscription plan, monthly credits, and assisted re-login when the token expires.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qianwen",
    "qwen",
    "dashboard",
    "status"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobeychan/dsh-qianwen-status-dashboard.git"
  },
  "homepage": "https://github.com/tobeychan/dsh-qianwen-status-dashboard#readme",
  "bugs": {
    "url": "https://github.com/tobeychan/dsh-qianwen-status-dashboard/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
